{
  "name": "off-my-lawn",
  "type": "module",
  "version": "0.0.1",
  "description": "Unicorns Off My Lawn! — 2026 js13kGames contestant",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "lint": "biome check",
    "typecheck": "tsc",
    "build": "tsc && vite build && rm -f dist.zip && cd dist && advzip -a ../dist.zip index.html && cd ../ && ls -l dist.zip",
    "preview": "vite preview",
    "serve": "cd dist && python -m http.server 8008",
    "check:tutorial": "node scripts/check-tutorial.mjs",
    "check:gameplay": "node scripts/check-gameplay.mjs"
  },
  "keywords": [],
  "author": "Michel Thadeu Sabchuk",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "terser": "5.50.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "packageManager": "pnpm@11.21.0",
  "pnpm": {
    "confirmModulesPurge": false
  }
}
